APP_NAME="Kantor Urusan Agama"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Default memakai SQLite (file database/database.sqlite).
# Untuk MySQL: ganti DB_CONNECTION=mysql lalu isi DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kua
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Identitas KUA (tampil di website)
KUA_NAMA="Kecamatan Kemang, Kab. Bogor, Jawa Barat"
KUA_KABUPATEN="Kecamatan Kemang, Kabupaten Bogor, Prov. Jawa Barat"
KUA_ALAMAT="Jl. Kemang Kiara No. 06, RT: 04/05, Desa Kemang, Kec. Kemang, Kab. Bogor, Prov. Jawa Barat"
KUA_TELEPON="0877-3942-9167"
KUA_EMAIL="kuakemangkabbogor@gmail.com"
KUA_JAM_LAYANAN="Senin–Jumat, 08.00–16.00 WIB"

# Kata sandi akun demo (admin/petugas/warga@kua.test) saat db:seed
DEMO_PASSWORD=password

# true = minta mesin pencari tidak mengindeks situs (untuk demo)
KUA_NOINDEX=false
